cmd_config() {
    local settings="$HOME/.openmono/settings.json"

    # Help works even without jq installed
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: openmono config <subcommand>"
        echo ""
        echo "  get <key>           Read a setting (dotted path, e.g. llm.endpoint)"
        echo "  set <key> <value>   Write a setting"
        echo "  unset <key>         Remove a setting"
        echo "  list                Print the whole settings file (default)"
        echo ""
        echo "Examples:"
        echo "  openmono config set llm.endpoint http://10.0.0.5:17474"
        echo "  openmono config set llm.api_key mytoken123"
        echo "  openmono config get llm.endpoint"
        echo "  openmono config unset llm.api_key"
        echo ""
        echo "Settings file: ~/.openmono/settings.json"
        return 0
    fi

    mkdir -p "$(dirname "$settings")"
    [[ -f "$settings" ]] || echo '{}' > "$settings"

    if ! command -v jq &>/dev/null; then
        err "jq is required for 'openmono config'. Install it: sudo apt install jq"
        return 1
    fi

    case "${1:-}" in
        get)
            if [[ -z "${2:-}" ]]; then
                err "Usage: openmono config get <key>"
                return 1
            fi
            jq -r ".$2 // empty" "$settings"
            ;;
        set)
            if [[ -z "${2:-}" || -z "${3:-}" ]]; then
                err "Usage: openmono config set <key> <value>"
                return 1
            fi
            local path="$2" value="$3"
            # Build a jq path like .llm.api_key from dotted input "llm.api_key"
            # shellcheck disable=SC2001
            local jq_path
            jq_path=".$(echo "$path" | sed 's/\./.\"/g; s/$/\"/; s/^\.\"/./')"
            jq "$jq_path = \"$value\"" "$settings" > "$settings.tmp"
            mv "$settings.tmp" "$settings"
            chmod 0600 "$settings"
            ok "$path = $value"
            ;;
        unset)
            if [[ -z "${2:-}" ]]; then
                err "Usage: openmono config unset <key>"
                return 1
            fi
            local upath="$2"
            local ujq
            ujq=".$(echo "$upath" | sed 's/\./.\"/g; s/$/\"/; s/^\.\"/./')"
            jq "del($ujq)" "$settings" > "$settings.tmp"
            mv "$settings.tmp" "$settings"
            chmod 0600 "$settings"
            ok "unset $upath"
            ;;
        list|"")
            jq . "$settings"
            ;;
        *)
            err "Unknown config subcommand: $1"
            echo "Run: openmono config --help"
            return 1
            ;;
    esac
}

# ── Tunnel (frpc) subcommands — run on the inference box ──────────────────────

tunnel_require_systemd() {
    if ! command -v systemctl &>/dev/null; then
        err "systemctl not available — tunnel commands are Linux/systemd only."
        exit 1
    fi
}

# Resolve a dual-box endpoint for rotate-key / status printing.
# Prefers Tailscale cache, then relay.json.
_tunnel_resolve_endpoint() {
    local ts_cache="$HOME/.openmono/tailscale-tunnel.json"
    local relay_cache="$HOME/.openmono/relay.json"
    local endpoint=""

    if [[ -f "$ts_cache" ]] && command -v jq &>/dev/null; then
        endpoint="$(jq -r '.endpoint // empty' "$ts_cache" 2>/dev/null || true)"
        # Refresh from live Tailscale if cache endpoint is stale/empty
        if [[ -z "$endpoint" ]] && command -v tailscale &>/dev/null; then
            local host port
            host="$(jq -r '.hostname // .ip // empty' "$ts_cache" 2>/dev/null || true)"
            port="$(jq -r '.port // 7474' "$ts_cache" 2>/dev/null || true)"
            [[ -n "$host" ]] && endpoint="http://${host}:${port}"
        fi
    fi

    if [[ -z "$endpoint" && -f "$relay_cache" ]] && command -v jq &>/dev/null; then
        local frps_addr remote_port
        frps_addr="$(jq -r '.frpsAddress // empty' "$relay_cache" 2>/dev/null)"
        remote_port="$(jq -r '.remotePort // empty' "$relay_cache" 2>/dev/null)"
        [[ -n "$frps_addr" && -n "$remote_port" ]] && \
            endpoint="http://${frps_addr}:${remote_port}"
    fi

    printf '%s' "$endpoint"
}

_tunnel_print_tailscale_status() {
    local ts_cache="$HOME/.openmono/tailscale-tunnel.json"

    echo ""
    echo -e "${BLUE}── Tailscale (dual-box) ─────────────────────────────${NC}"

    if ! resolve_tailscale_cli; then
        if [[ -f "$ts_cache" ]]; then
            warn "tailscale CLI missing but cache exists: $ts_cache"
        else
            info "tailscale not installed (optional). Setup: openmono tunnel setup --tailscale"
        fi
        return 0
    fi

    local backend="" dns="" ip=""
    backend="$(tailscale_backend_state 2>/dev/null || true)"
    if [[ "$backend" == "Running" ]]; then
        local st
        st="$(tailscale_cmd status --json 2>/dev/null || true)"
        dns="$(echo "$st" | jq -r '.Self.DNSName // empty' 2>/dev/null | sed 's/\.$//' || true)"
        ip="$(tailscale_cmd ip -4 2>/dev/null | head -1 || true)"
        ok "tailscale → Running ($TAILSCALE_BIN)"
        [[ -n "$dns" ]] && info "MagicDNS = $dns"
        [[ -n "$ip" ]] && info "IPv4 = $ip"
        local port="${LLAMA_PORT:-7474}"
        if [[ -f "$ts_cache" ]] && command -v jq &>/dev/null; then
            port="$(jq -r '.port // 7474' "$ts_cache" 2>/dev/null || echo "$port")"
            local cached
            cached="$(jq -r '.endpoint // empty' "$ts_cache" 2>/dev/null || true)"
            [[ -n "$cached" ]] && info "Cached endpoint: $cached"
        fi
        if [[ -n "$dns" ]]; then
            info "Suggested endpoint: http://${dns}:${port}"
        elif [[ -n "$ip" ]]; then
            info "Suggested endpoint: http://${ip}:${port}"
        fi
    else
        warn "tailscale → ${backend:-not connected} ($TAILSCALE_BIN)"
        if [[ "$backend" == "NeedsLogin" || "$backend" == "PrefsError" || -z "$backend" ]]; then
            tailscale_login_hint 2>&1 | while IFS= read -r line; do warn "$line"; done
        elif [[ -f "$ts_cache" ]]; then
            warn "Cache present: $ts_cache — re-run: openmono tunnel setup --tailscale"
        else
            info "Optional setup: openmono tunnel setup --tailscale"
        fi
    fi
}

cmd_tunnel() {
    local sub="${1:-help}"
    shift || true
    case "$sub" in
        setup)
            local use_tailscale=false
            local setup_args=()
            for arg in "$@"; do
                case "$arg" in
                    --tailscale) use_tailscale=true ;;
                    *) setup_args+=("$arg") ;;
                esac
            done
            if [[ "$use_tailscale" == "true" ]]; then
                bash "$REPO_DIR/scripts/setup-tunnel-tailscale.sh" --tailscale "${setup_args[@]}"
            else
                bash "$REPO_DIR/scripts/setup-tunnel-inference.sh" "${setup_args[@]}"
            fi
            ;;
        prepare)
            bash "$REPO_DIR/scripts/prepare-dualbox-macos.sh" "$@"
            ;;
        doctor|secure-check)
            # Decision: doctor = prepare + security probes (does not exit early on prepare fail)
            local prep_rc=0
            bash "$REPO_DIR/scripts/prepare-dualbox-macos.sh" "$@" || prep_rc=$?
            echo ""
            echo -e "${BLUE}── Security checklist ────────────────────────────────${NC}"
            info "See docs/SECURITY.md"
            if [[ -f "$HOME/.openmono/settings.json" ]] && command -v jq &>/dev/null; then
                local ep key
                ep="$(jq -r '.llm.endpoint // empty' "$HOME/.openmono/settings.json")"
                key="$(jq -r '.llm.api_key // empty' "$HOME/.openmono/settings.json")"
                if [[ -n "$ep" && "$ep" != http://localhost* && "$ep" != http://127.0.0.1* ]]; then
                    if curl -sf --max-time 3 "${ep%/}/health" &>/dev/null; then
                        ok "Remote health OK: $ep/health"
                    else
                        warn "Remote health failed: $ep/health (is Mini up + Tailscale Running?)"
                    fi
                    if [[ -z "$key" ]]; then
                        warn "Missing llm.api_key — chat will 401 until set"
                        info "Helper: ./scripts/secure-mini-ssh-and-key.sh"
                        info "Then:   ./scripts/apply-mini-endpoint.sh <key>"
                    else
                        local code
                        code="$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' \
                            -H "Authorization: Bearer ${key}" \
                            -H 'Content-Type: application/json' \
                            -d '{"model":"local","messages":[{"role":"user","content":"ping"}],"max_tokens":1}' \
                            "${ep%/}/v1/chat/completions" 2>/dev/null || echo 000)"
                        if [[ "$code" == "200" ]]; then
                            ok "Authenticated chat probe → HTTP $code"
                        else
                            warn "Authenticated chat probe → HTTP ${code:-000} (rotate/copy key from Mini)"
                        fi
                    fi
                fi
            fi
            return "$prep_rc"
            ;;
        start)
            tunnel_require_systemd
            info "Starting frpc tunnel..."
            sudo systemctl start frpc
            sleep 1
            if systemctl is-active --quiet frpc; then
                ok "frpc is active"
            else
                err "frpc failed to start. Check: openmono tunnel logs"
                exit 1
            fi
            ;;
        stop)
            tunnel_require_systemd
            info "Stopping frpc tunnel..."
            sudo systemctl stop frpc
            ok "Stopped"
            ;;
        restart)
            tunnel_require_systemd
            info "Restarting frpc tunnel..."
            sudo systemctl restart frpc
            sleep 1
            if systemctl is-active --quiet frpc; then
                ok "frpc is active"
            else
                err "frpc failed to restart. Check: openmono tunnel logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo -e "${BLUE}── frpc (tunnel) service ────────────────────────────${NC}"
            if command -v systemctl &>/dev/null \
                && systemctl list-unit-files 2>/dev/null | grep -q '^frpc\.service'; then
                if systemctl is-active --quiet frpc; then
                    ok "frpc.service → active"
                else
                    warn "frpc.service → inactive"
                fi
                systemctl --no-pager -n 3 status frpc 2>/dev/null | sed -n '1,5p' || true
            else
                warn "frpc.service not installed. Run: openmono tunnel setup"
            fi

            echo ""
            echo -e "${BLUE}── Configured frp target ────────────────────────────${NC}"
            if [[ -f /etc/frp/frpc.toml ]]; then
                local server_addr remote_port
                server_addr="$(awk -F'"' '/^serverAddr/{print $2; exit}' /etc/frp/frpc.toml 2>/dev/null)"
                remote_port="$(awk -F'= *' '/^remotePort/{print $2; exit}' /etc/frp/frpc.toml 2>/dev/null | tr -d ' ')"
                [[ -n "$server_addr" ]] && info "serverAddr = $server_addr"
                [[ -n "$remote_port" ]] && info "remotePort = $remote_port"
                if [[ -n "$server_addr" && -n "$remote_port" ]]; then
                    info "Public endpoint: http://$server_addr:$remote_port"
                fi
            else
                warn "/etc/frp/frpc.toml not found"
            fi

            _tunnel_print_tailscale_status
            echo ""
            ;;
        logs)
            tunnel_require_systemd
            sudo journalctl -u frpc -f
            ;;
        rotate-key)
            if [[ "$NATIVE_INFERENCE" == "true" ]]; then
                native_cmd_tunnel_rotate_key
            else
                local env_file="$REPO_DIR/docker/.env"

                if [[ ! -f "$env_file" ]]; then
                    err "docker/.env not found. Run 'openmono tunnel setup' first."
                    return 1
                fi

                local new_key
                new_key="$(openssl rand -hex 24)"

                # Write new key to docker/.env
                local tmp
                tmp="$(mktemp)"
                grep -v '^LLAMA_API_KEY=' "$env_file" > "$tmp" || true
                echo "LLAMA_API_KEY=$new_key" >> "$tmp"
                mv "$tmp" "$env_file"
                chmod 0600 "$env_file"
                ok "LLAMA_API_KEY rotated in docker/.env"

                # Restart llama-server to enforce the new key immediately
                if command -v docker &>/dev/null && docker compose version &>/dev/null 2>&1; then
                    if (cd "$REPO_DIR/docker" && docker compose ps --services 2>/dev/null | grep -q '^llama-server$'); then
                        info "Restarting llama-server with new API key..."
                        (cd "$REPO_DIR/docker" && docker compose restart llama-server) || \
                            warn "Restart failed — run manually: cd docker && docker compose restart llama-server"
                        ok "llama-server restarted"
                    else
                        warn "llama-server is not running — start it with: openmono start"
                    fi
                else
                    warn "docker compose not found — restart llama-server manually to enforce the new key"
                fi

                local endpoint
                endpoint="$(_tunnel_resolve_endpoint)"

                echo ""
                printf "${BLUE}%s${NC}\n" "$(printf '─%.0s' $(seq 1 60))"
                printf "${BLUE}${BOLD}  API Key Rotated${NC}\n"
                printf "${BLUE}%s${NC}\n" "$(printf '─%.0s' $(seq 1 60))"
                echo ""
                echo "  Run the following on the agent box to apply the new key:"
                echo ""
                [[ -n "$endpoint" ]] && \
                    printf "    ${BOLD}openmono config set llm.endpoint  %s${NC}\n" "$endpoint"
                printf "    ${BOLD}openmono config set llm.api_key   %s${NC}\n" "$new_key"
                echo ""
            fi
            ;;
        help|--help|-h|"")
            echo "Usage: openmono tunnel <subcommand>"
            echo ""
            echo "Run on the inference box. Dual-box transports:"
            echo "  • frp relay (default) — systemd service frpc.service"
            echo "  • Tailscale           — MagicDNS / 100.x; own daemon (tailscaled)"
            echo ""
            echo "  setup [--tailscale] [--auth-key tskey-auth-...]"
            echo "              Default: install frpc + systemd unit for the"
            echo "              openmonoagent relay. With --tailscale: join/reuse"
            echo "              a Tailscale tailnet and print agent config."
            echo "              Preserves existing LLAMA_API_KEY."
            echo "  prepare [--inference|--agent]"
            echo "              Dual-box readiness checklist (Wi-Fi + Tailscale)."
            echo "              Auto-picks role: arm64 Mac → inference, else agent."
            echo "  doctor      Same as prepare, plus health + API-key chat probe."
            echo "  rotate-key  Generate a new LLAMA_API_KEY and restart llama-server."
            echo "              Prints config set commands for the agent box"
            echo "              (Tailscale endpoint preferred over relay when both exist)."
            echo "  start       systemctl start frpc          (frp only)"
            echo "  stop        systemctl stop frpc           (frp only)"
            echo "  restart     systemctl restart frpc        (frp only)"
            echo "  status      Show frpc + Tailscale state / endpoints"
            echo "  logs        journalctl -u frpc -f         (frp only)"
            echo ""
            echo "frp config: /etc/frp/frpc.toml"
            echo "Tailscale cache: ~/.openmono/tailscale-tunnel.json"
            ;;
        *)
            err "Unknown tunnel subcommand: $sub"
            cmd_tunnel help
            return 1
            ;;
    esac
}

# ── Entry point ───────────────────────────────────────────────────────────────

# Pre-parse global flags that may appear before any subcommand. Recognised
# global flags are stripped from the positional list and (where relevant)
# forwarded to the underlying agent binary.
AGENT_FORWARD=()
POSITIONAL=()
for arg in "$@"; do
    case "$arg" in
        --verbose|-v)
            export OPENMONO_VERBOSE=1
            AGENT_FORWARD+=("--verbose")
            ;;
        *)
            POSITIONAL+=("$arg")
            ;;
    esac
done

# If the only thing the user passed was a global flag (e.g. `openmono --verbose`),
# default to running the agent. Otherwise fall back to `help` as before.
if [ ${#POSITIONAL[@]} -eq 0 ]; then
    if [ ${#AGENT_FORWARD[@]} -gt 0 ]; then
        COMMAND="agent"
    else
        COMMAND="help"
    fi
    set --
else
    COMMAND="${POSITIONAL[0]}"
    set -- "${POSITIONAL[@]:1}"
fi

case "$COMMAND" in
    setup)          cmd_setup "$@";;
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    agent)          cmd_agent "${AGENT_FORWARD[@]+"${AGENT_FORWARD[@]}"}" "$@" ;;
    logs)           cmd_logs ;;
    status)         cmd_status ;;
    graph)          cmd_graph "$@" ;;
    graphify)       cmd_graphify "$@" ;;
    config)         cmd_config "$@" ;;    
    tunnel)         cmd_tunnel "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        err "Unknown command: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
